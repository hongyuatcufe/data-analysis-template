[project]
name = "PROJECT_NAME_HERE"
version = "0.1.0"
description = "Data analysis project following data-analysis-pipeline conventions"
requires-python = ">=3.12"
dependencies = [
    # 数据与统计
    "pandas>=2.2",
    "numpy>=1.26",
    "scipy>=1.13",
    "statsmodels>=0.14",
    # Excel
    "openpyxl>=3.1",
    # 可视化
    "plotly>=5.22",
    "kaleido>=0.2.1",          # Plotly 静态导出 PNG
    "matplotlib>=3.8",
    "seaborn>=0.13",
    # 报告生成
    "python-docx>=1.1",
    "python-pptx>=0.6.23",
    # 中文文本（如有开放题）
    "jieba>=0.42",
    "wordcloud>=1.9",
]

[tool.uv]
# uv 推荐配置
package = false
